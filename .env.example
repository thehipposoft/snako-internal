# Copiá este archivo a .env.local y completá los valores reales.
# Están en Supabase > tu proyecto > Project Settings > API.
# .env.local queda fuera de git (ver .gitignore) — nunca commitear estas claves.

# URL del proyecto (pública, segura de exponer en el navegador)
NEXT_PUBLIC_SUPABASE_URL=

# anon/public key (pública, segura de exponer en el navegador — el acceso
# real lo controla Row Level Security, no el secreto de esta key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRETA — ignora RLS por completo, solo se usa en
# código de servidor: src/lib/supabase/server.ts). Nunca exponerla con
# el prefijo NEXT_PUBLIC_, nunca usarla en un componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=
